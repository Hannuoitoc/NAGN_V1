<UserControl x:Class="NAGN_V1.View.NodeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:NAGN_V1.View"
             mc:Ignorable="d" 
              Width="180" Height="110">
    <Grid>
        <!-- Khung chính của Node -->
        <Border BorderThickness="2" CornerRadius="8" Background="#252526" Margin="0,8">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="#3F3F46"/>
                    <Style.Triggers>
                        <!-- Viền sáng lên màu cam khi Node được chọn -->
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter Property="BorderBrush" Value="#FF9D00"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!--TÊN ĐỐI TƯỢNG (HEADER) -->
                <Border Grid.Row="0" Background="#2D2D30" CornerRadius="6,6,0,0">
                    <TextBlock Text="{Binding Name}"
                               Foreground="White" FontWeight="Bold" 
                               FontSize="7" VerticalAlignment="Center" 
                               HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </Border>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- HÌNH ẢNH (PREVIEW/ICON) -->
                    <Border Grid.Column="0" Margin="6" CornerRadius="4">
                        <Grid>
                            <Image Source="\acsset\oip.webp" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- GHI CHÚ / MÔ TẢ (NOTE) -->
                    <Border Grid.Column="1" Margin="6,0,6,6" CornerRadius="4" Padding="4">
                        <TextBlock FontSize="8" Text="{Binding Description}" 
                             Foreground="Green" Background="Transparent" TextWrapping="Wrap"/>
                    </Border>
                </Grid>
                
            </Grid>
        </Border>

        <!--NÚT NỐI DÂY TÊN (TOP PORT - INPUT) -->
        <Ellipse x:Name="TopPort" Width="14" Height="14" Fill="#007ACC" Stroke="White" StrokeThickness="1.5"
                 HorizontalAlignment="Center" VerticalAlignment="Top" Cursor="Cross"
                 ToolTip="Input Port (Top)"/>

        <!-- 5. NÚT NỐI DÂY DƯỚI (BOTTOM PORT - OUTPUT) -->
        <Ellipse x:Name="BottomPort" Width="14" Height="14" Fill="#28A745" Stroke="White" StrokeThickness="1.5"
                 HorizontalAlignment="Center" VerticalAlignment="Bottom" Cursor="Cross"
                 ToolTip="Output Port (Bottom)"/>
    </Grid>
</UserControl>
