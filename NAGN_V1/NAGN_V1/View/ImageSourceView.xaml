<UserControl x:Class="NAGN_V1.View.ImageSourceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:NAGN_V1.View"
             mc:Ignorable="d" 
             MinWidth="260" MinHeight="200" Background="#1E1E1E">

    <!-- THANH CUỘN BỌC TOÀN BỘ NỘI DUNG -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" 
                  HorizontalScrollBarVisibility="Disabled"
                  Focusable="False">

        <Border BorderThickness="1" BorderBrush="#3F3F46" CornerRadius="6" Padding="12" Background="#252526">
            <StackPanel>
                <!-- Tên node -->
                <TextBlock Text="Tên Node:" Foreground="#AAAAAA" FontSize="11" Margin="0,0,0,4"/>
                <TextBox Text="{Binding ImageSource.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                         Foreground="White" Background="#1E1E1E" 
                         BorderBrush="#3F3F46" Padding="6,4" Margin="0,0,0,12" 
                         FontSize="12" FontWeight="SemiBold"/>

                <!-- Nguồn ảnh -->
                <TextBlock Text="Nguồn ảnh (Image Source):" Foreground="#AAAAAA" FontSize="11" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" 
                             Text="{Binding ImageSource.filePath}" 
                             Foreground="#CCCCCC" Background="#1E1E1E" 
                              Padding="6,4" FontSize="11"
                             />

                    <Button Grid.Column="1" 
                            Width="30" Height="26" Margin="6,0,0,0"
                            Background="#3E3E42" Foreground="White" 
                            BorderBrush="#555555" Cursor="Hand"
                            ToolTip="Chọn ảnh từ máy tính" Command="{Binding GetImageSourceCommand}">
                        <TextBlock Text="📁" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </Grid>
                <!-- KHUNG PREVIEW ÀNH (Cho phép co giãn chiều cao linh hoạt) -->
                <TextBlock Text="Xem trước ảnh:" Foreground="#AAAAAA" FontSize="11" Margin="0,0,0,4"/>
                <Border MinHeight="120" MaxHeight="250" Background="#1E1E1E" 
                        BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="4" Margin="0,0,0,12">
                    <Grid>
                        <Image Source="{Binding ImageSource.image}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        <TextBlock Text="Chưa có hình ảnh" Foreground="#555555" FontSize="11"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ImageSource.image}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
                <!-- Mô tả -->
                <TextBlock Text="Description:" Foreground="#AAAAAA" FontSize="11" Margin="0,0,0,4"/>
                <TextBox Text="{Binding ImageSource.Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                         Foreground="#CCCCCC" Background="#1E1E1E" 
                         BorderBrush="#3F3F46" Padding="6" MinHeight="60" MaxHeight="120"
                         TextWrapping="Wrap" AcceptsReturn="True" 
                         VerticalScrollBarVisibility="Auto" FontSize="11"/>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
